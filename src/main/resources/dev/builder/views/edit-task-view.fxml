<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>
<?import javafx.scene.web.*?>

<VBox alignment="TOP_CENTER" spacing="15" style="-fx-background-color: #fff; -fx-background-radius: 15;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.builder.board.application.controller.TaskController">
   <Label fx:id="lblError" style="-fx-text-fill: red;" text="" />

   <!-- Título del modal -->
   <Label styleClass="modal-title" text="Información de la tarea">
      <font>
         <Font name="System Bold" size="29.0" />
      </font></Label>

   <!-- Campo de título con RadioButton indicativo -->
   <HBox alignment="CENTER_LEFT" spacing="10">
      <RadioButton fx:id="rbTitle" />
      <TextField fx:id="txtEditTitle" prefHeight="21.0" prefWidth="773.0" promptText="Ingrese el título" style="-fx-background-color: #fff; -fx-border-color: #fff;" HBox.hgrow="ALWAYS">
         <font>
            <Font name="System Bold" size="23.0" />
         </font></TextField>
   </HBox>

   <!-- Selección de miembros y fechas -->
   <HBox spacing="10">
      <Button fx:id="btnEditMembers" text="Miembros..." />
      <DatePicker fx:id="dpStartEdit" promptText="Fecha inicio" />
      <DatePicker fx:id="dpEndEdit" promptText="Fecha fin" />
   </HBox>

   <!-- Descripción con editor enriquecido -->
   <HBox alignment="CENTER_LEFT" />
   <HTMLEditor fx:id="descriptionEditorEdit" prefHeight="200" VBox.vgrow="ALWAYS" />

   <!-- Botones de acción -->
   <HBox alignment="CENTER_RIGHT" spacing="10">
      <Button fx:id="btnCancel" text="Cancelar" />
      <Button fx:id="btnSave" defaultButton="true" style="-fx-background-color: #0647F0;" text="Guardar" textFill="WHITE" />
   </HBox>
   <padding>
      <Insets bottom="20" left="20" right="20" top="20" />
   </padding>

</VBox>
