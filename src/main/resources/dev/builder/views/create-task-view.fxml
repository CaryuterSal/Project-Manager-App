<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="664.0" prefWidth="1285.0" style="-fx-border-radius: 10px; -fx-background-radius: 10px;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.builder.board.application.controller.TaskFormController">
   <children>
      <StackPane fx:id="coverImageContainer" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" minHeight="150.0" prefHeight="150.0" prefWidth="200.0" style="-fx-background-image: url(dev/builder/assets/images/task_background_placeholder.jpg);">
         <children>
            <Button fx:id="addCoverImageBtn" mnemonicParsing="false" style="-fx-padding: 10; -fx-background-color: white;" stylesheets="@../assets/styles/primary-button.css" StackPane.alignment="TOP_LEFT">
               <graphic>
                  <ImageView fitHeight="35.0" fitWidth="35.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../assets/images/add_image_icon.png" />
                     </image>
                  </ImageView>
               </graphic>
               <StackPane.margin>
                  <Insets left="40.0" top="30.0" />
               </StackPane.margin>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </StackPane>
      <StackPane maxHeight="1.7976931348623157E308">
         <children>
            <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" spacing="15" style="-fx-background-color: #fff; -fx-background-radius: 15;">
               <padding>
                  <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
               </padding>
            
               <!-- Título del modal -->
               <Label text="Agregar tarea">
                  <font>
                     <Font name="System Bold" size="29.0" />
                  </font>
               </Label>
            
               <!-- Campo de título con RadioButton indicativo -->
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <MenuButton fx:id="colorSelector" mnemonicParsing="false" styleClass="button" stylesheets="@../assets/styles/secondary-text-button.css">
                     <graphic>
                        <Circle fx:id="colorCircle" fill="WHITE" radius="20.0" stroke="BLACK" strokeType="INSIDE" />
                     </graphic>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </MenuButton>
                  <TextField fx:id="txtTitle" maxWidth="1.7976931348623157E308" promptText="Ingrese el título" style="-fx-background-color: #fff; -fx-border-color: #fff;" HBox.hgrow="ALWAYS">
                     <font>
                        <Font size="21.0" />
                     </font>
                  </TextField>
               </HBox>
            
               <!-- Selección de miembros y fechas -->
               <HBox alignment="CENTER_LEFT" spacing="10">
                  <VBox>
                     <children>
                        <MenuButton fx:id="btnMembers" mnemonicParsing="false" stylesheets="@../assets/styles/username-button.css" text="Añadir Miembros">
                           <graphic>
                              <ImageView fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
