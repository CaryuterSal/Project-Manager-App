                                    <Image url="@../assets/images/add_manager_icon.png" />
                                 </image>
                              </ImageView>
                           </graphic>
                        </MenuButton>
                        <FlowPane fx:id="collaboratorsPillContainer" hgap="10.0" maxHeight="-Infinity" maxWidth="-Infinity" vgap="10.0" />
                     </children>
                  </VBox>
                  <VBox spacing="5.0">
                     <children>
                        <Label text="Fecha límite" />
                        <DatePicker fx:id="dpEnd" promptText="mm/dd/YYY" />
                     </children>
                  </VBox>
                  <Button fx:id="addAttachmentBtn" mnemonicParsing="false" stylesheets="@../assets/styles/secondary-text-button.css" text="Añadir archivo adjunto" wrapText="true">
                     <graphic>
                        <ImageView fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../assets/images/upload.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
                  <FlowPane fx:id="attachmentPillContainer" hgap="10.0" vgap="10.0" />
               </HBox>
            
               <!-- Descripción con editor enriquecido -->
               <HBox alignment="CENTER_LEFT" />
               <VBox fx:id="descriptionVisualizerContainer" prefHeight="200.0" prefWidth="100.0">
                  <children>
                     <Label text="Descripción">
                        <font>
                           <Font size="15.0" />
                        </font>
                     </Label>
                     <WebView fx:id="descriptionVisualizer" prefHeight="200.0" prefWidth="200.0" />
                  </children>
               </VBox>
               <HTMLEditor fx:id="descriptionEditor" prefHeight="200" VBox.vgrow="ALWAYS" />
            
               <!-- Botones de acción -->
               <HBox alignment="CENTER_RIGHT" spacing="10">
                  <Button fx:id="btnCancel" style="-fx-background-color: transparent; -fx-border-color: black; -fx-text-fill: black;" text="Cancelar">
