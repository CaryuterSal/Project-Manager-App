                  </Button>
                  <Button fx:id="btnSave" defaultButton="true" stylesheets="@../assets/styles/primary-button.css" text="Agregar" textFill="WHITE">
                     <font>
                        <Font size="18.0" />
                     </font>
                  </Button>
               </HBox>
            
            </VBox>
            <ProgressBar fx:id="loadIndicator" maxWidth="1.7976931348623157E308" stylesheets="@../assets/styles/progress-bar.css" StackPane.alignment="TOP_CENTER" />
         </children>
      </StackPane>
   </children>
