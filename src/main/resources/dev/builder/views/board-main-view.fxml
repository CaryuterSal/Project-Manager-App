<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="609.0" prefWidth="1053.0" style="-fx-background-color: #ffffff;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.builder.board.application.controller.ManagerBoardController">
   <!-- Side navigation -->
   <left>
      <VBox prefHeight="609.0" prefWidth="222.0" spacing="20" style="-fx-background-color: #f7f7f7;" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <Label text="Kedu">
            <graphic>
               <ImageView fx:id="logoImageView" fitHeight="50.0" fitWidth="34.0" preserveRatio="true">
                  <image>
                     <Image url="@../assets/images/logo.png" />
                  </image>
               </ImageView>
            </graphic>
            <font>
               <Font name="System Bold" size="25.0" />
            </font>
         </Label>
         <VBox fx:id="navButtons" spacing="10">
            <Button fx:id="btnBoard" style="-fx-background-color: black; -fx-background-radius: 28;" text="Tablero" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="23.0" />
               </font>
               <VBox.margin>
                  <Insets left="15.0" right="15.0" top="10.0" />
               </VBox.margin>
               <graphic>
                  <Pane prefHeight="33.0" prefWidth="32.0" style="-fx-background-color: white; -fx-background-radius: 50;">
                     <children>
                        <ImageView fitHeight="33.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true" x="1.0" y="2.0">
                           <image>
                              <Image url="@../assets/images/board_icon.png" />
                           </image>
                        </ImageView>
                     </children>
                  </Pane>
               </graphic></Button>
            <Button fx:id="btnAccount" onAction="#onAccountClicked" style="-fx-background-color: #f7f7f7; -fx-border-color: #f7f7f7;" text="Cuentas" textFill="#919191">
               <font>
                  <Font name="System Bold" size="23.0" />
               </font>
               <VBox.margin>
                  <Insets left="9.0" right="15.0" />
               </VBox.margin>
               <graphic>
                  <ImageView fitHeight="50.0" fitWidth="34.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../assets/images/add_manager_icon.png" />
                     </image>
                  </ImageView>
               </graphic></Button>
         </VBox>
         <VBox.vgrow>ALWAYS</VBox.vgrow>
      </VBox>
   </left>

   <!-- Main content -->
   <center>
      <VBox spacing="15" style="-fx-background-color: white; -fx-background-radius: 20;">
         <padding>
            <Insets bottom="20" left="20" right="20" top="20" />
         </padding>
         <!-- Header with title, search and invite -->
         <HBox spacing="10">
            <VBox prefHeight="100.0" prefWidth="241.0">
               <children>
                  <Label styleClass="header-title" text="Incubadora">
                     <font>
                        <Font name="System Bold" size="26.0" />
                     </font>
                  </Label>
                  <TextField fx:id="txtSearch" alignment="CENTER" prefHeight="25.0" prefWidth="144.0" promptText="Buscar" style="-fx-background-radius: 28; -fx-background-color: #dcdcdc;">
                     <VBox.margin>
                        <Insets right="5.0" top="30.0" />
                     </VBox.margin>
                     <font>
                        <Font size="14.0" />
                     </font>
                  </TextField>
               </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <VBox prefHeight="105.0" prefWidth="164.0">
               <children>
                  <Button fx:id="btnInvite" style="-fx-background-color: black; -fx-background-radius: 28;" text="Invitar" textFill="WHITE">
                     <VBox.margin>
                        <Insets top="55.0" />
                     </VBox.margin>
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                     <graphic>
                        <ImageView fitHeight="33.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                           <image>
                              <Image url="@../assets/images/add_icon_white.png" />
                           </image>
                        </ImageView>
                     </graphic>
                  </Button>
               </children>
            </VBox>
         </HBox>

         <Label fx:id="lblError" text="" style="-fx-text-fill: red;" />

         <!-- Board columns inside a scrollable area -->
         <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: #f7f7f7; -fx-background-radius: 15;" vbarPolicy="AS_NEEDED">
            <content>
               <HBox spacing="20" style="-fx-background-color: #f7f7f7; -fx-background-radius: 15;">
                  <padding>
                     <Insets bottom="10" left="10" right="10" top="10" />
                  </padding>
                  <!-- "Por hacer" column -->
                  <VBox fx:id="todoColumn" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                     <Label styleClass="column-title" text="Por hacer">
                        <font>
                           <Font size="17.0" />
                        </font>
                        <VBox.margin>
                           <Insets left="5.0" top="3.0" />
                        </VBox.margin></Label>
                     <VBox fx:id="todoList" spacing="10">
                        <VBox.vgrow>ALWAYS</VBox.vgrow>
                     </VBox>
                     <Hyperlink fx:id="btnAddTask" text="+ Agregar" onAction="#onAddTaskClicked"/>
                  </VBox>

                  <!-- "En ejecución" column -->
                  <VBox fx:id="inProgressColumn" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                     <Label styleClass="column-title" text="En ejecución">
                        <VBox.margin>
                           <Insets left="5.0" top="3.0" />
                        </VBox.margin>
                        <font>
                           <Font size="17.0" />
                        </font></Label>
                     <VBox fx:id="inProgressList" spacing="10">
                        <VBox.vgrow>ALWAYS</VBox.vgrow>
                     </VBox>
                  </VBox>

                  <!-- "Finalizadas" column -->
                  <VBox fx:id="doneColumn" spacing="10" style="-fx-background-color: white; -fx-background-radius: 10;" HBox.hgrow="ALWAYS">
                     <Label styleClass="column-title" text="Finalizadas">
                        <font>
                           <Font size="17.0" />
                        </font>
                        <VBox.margin>
                           <Insets left="5.0" top="3.0" />
                        </VBox.margin></Label>
                     <VBox fx:id="doneList" spacing="10">
                        <VBox.vgrow>ALWAYS</VBox.vgrow>
                     </VBox>
                  </VBox>
               </HBox>
            </content>
         </ScrollPane>
      </VBox>
   </center>
</BorderPane>
