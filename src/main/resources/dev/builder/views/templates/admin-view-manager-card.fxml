<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER" spacing="50.0" style="-fx-border-radius: 20; -fx-background-radius: 20; -fx-background-color: white;" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.builder.usermanagement.application.controller.ManagerCardController">
   <children>
      <Label fx:id="email" maxWidth="1.7976931348623157E308" text="correo" HBox.hgrow="ALWAYS">
         <font>
            <Font size="19.0" />
         </font></Label>
      <Separator orientation="VERTICAL" />
      <Button fx:id="disableButton" mnemonicParsing="false" stylesheets="@../../assets/styles/delete-button.css" text="Deshabilitar" textFill="WHITE">
         <cursor>
            <Cursor fx:constant="HAND" />
         </cursor>
         <font>
            <Font size="18.0" />
         </font>
      </Button>
   </children>
   <padding>
      <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
   </padding>
</HBox>
