<StackPane fx:controller="dev.builder.board.application.controller.AssigneePillController" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label fx:id="emailLbl" style="-fx-background-color: black; -fx-padding: 10 40 10 15; -fx-background-radius: 999;" text="20243ds158@utez.edu.mx" textFill="WHITE">
