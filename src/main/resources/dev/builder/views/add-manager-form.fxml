<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="281.0" prefWidth="428.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.builder.usermanagement.application.controller.RegisterManagerController">
   <center>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Correo Electrónico">
               <font>
                  <Font size="18.0" />
               </font>
               <VBox.margin>
                  <Insets />
               </VBox.margin>
            </Label>
            <TextField fx:id="emailInput" promptText="Jhon@example.com" style="-fx-border-radius: 5; -fx-background-radius: 5;">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </TextField>
            <HBox fx:id="errorPrompt" spacing="6.0" visible="false">
               <children>
                  <ImageView fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../assets/images/error.png" />
                     </image>
                  </ImageView>
                  <Label fx:id="errorField" text="El campo no puede ser nulo" textFill="#eb0d0d" wrapText="true" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" left="30.0" right="30.0" top="30.0" />
         </BorderPane.margin>
      </VBox>
   </center>
   <top>
      <VBox alignment="TOP_CENTER" spacing="25.0" BorderPane.alignment="CENTER">
         <children>
            <ProgressBar fx:id="progressBar" maxWidth="1.7976931348623157E308" stylesheets="@../assets/styles/progress-bar.css" visible="false" />
            <Label text="Registrar Maestro">
               <font>
                  <Font name="System Bold" size="21.0" />
               </font>
            </Label>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </top>
   <bottom>

            <HBox alignment="CENTER_RIGHT" spacing="50.0" BorderPane.alignment="CENTER">
         <children>
            <Button fx:id="cancelBtn" cancelButton="true" mnemonicParsing="false" style="-fx-background-color: white; -fx-border-color: black; -fx-border-width: 1; -fx-background-radius: 18; -fx-border-radius: 18;" text="Cancelar">
               <font>
                  <Font size="18.0" />
               </font>
               <padding>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </padding>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="registerBtn" defaultButton="true" mnemonicParsing="false" style="-fx-background-color: #17171a; -fx-background-radius: 18;" text="Registrar" textFill="WHITE">
               <font>
                  <Font size="18.0" />
               </font>
               <padding>
                  <Insets bottom="5.0" left="20.0" right="20.0" top="5.0" />
               </padding>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets bottom="30.0" left="30.0" right="30.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
</BorderPane>
